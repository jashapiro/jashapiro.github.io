}

@ARTICLE{Reddi2003-xd,
  title    = "Spermatid-specific promoter of the {SP-10} gene functions as an
              insulator in somatic cells",
  author   = "Reddi, P Prabhakara and Shore, Amy N and Shapiro, Joshua A and
              Anderson, Alice and Stoler, Mark H and Acharya, Kshitish K",
  abstract = "Spermatid differentiation markers such as the acrosomal protein
              SP-10 display remarkable testis- and germ cell-restricted gene
              expression. However, little is known about the mechanisms that
              prevent their expression in somatic tissues. We have previously
              noted that the -408/+28 or the -266/+28 promoter of SP-10
              directed strictly spermatid-specific transcription in transgenic
              mice, Biol. Reprod. 61, 1256-1266). Lack of ectopic expression in
